9\u3092\u3057\u307e\u3057\u3087\u3046</p>"},{"location":"mekacraft/#_1","title":"\u6ce8\u610f\u4e8b\u9805","text":"<p>\u81ea\u4f5c\u767a\u8a00\u3060\u3051\u306a\u3057 \u5e38\u8b58\u306e\u7bc4\u56f2\u5185\u3067ok \u3053\u306emodpack\u304c\u9762\u767d\u304f\u306a\u3044\u3053\u3068\u3092\u4fdd\u8a3c\u3057\u307e\u3059</p> <p>https://github.com/okomehannta/meka-craft</p>"},{"location":"mekacraft/#_2","title":"\u5927\u307e\u304b\u306a\u6d41\u308c","text":"<p>create\u3092\u3084\u308b mekanism\u51b6\u91d1\u6ce8\u5165\u6a5f\u3092\u4f5c\u308b mekanism\u3092\u3084\u308b mekanism extra\u3068\u304b\u3092\u3084\u308b</p> <p>\u3053\u306emodpack\u306b\u306f\u3042\u307e\u308a\u4fa1\u5024\u304c\u306a\u3044\u306e\u3067\u8a73\u7d30\u306f\u7701\u304d\u307e\u3059 \u307e\u3042\u307e\u3042\u306a\u8efd\u91cf\u3067\u52d5\u304d\u307e\u3059 1.20.1\u5de5\u696dmodpack</p>"},{"location":"mekanism/","title":"mekanism","text":"<p>\u4f5c\u308a\u304b\u3051\u8a18\u4e8b \u6700\u7d42\u66f4\u65b026/10/25</p> <p>minecraft1.20.1\u306b\u304a\u3051\u308bmekanism\u3092\u89e3\u8aac\u3057\u307e\u3059 \u516c\u5f0f\u30a2\u30c9\u30aa\u30f3\u3000mekanism generator\u304c\u5165\u3063\u3066\u3044\u308b\u524d\u63d0\u3067\u89e3\u8aac\u3057\u307e\u3059</p>"},{"location":"mekanism/#_1","title":"\u6982\u8981","text":"<p>\u30d0\u30fc\u30b8\u30e7\u30f31.7.10~1.21.1</p>"},{"location":"mekanism/#_2","title":"\u914d\u5e03\u30b5\u30a4\u30c8","text":"<p>https://www.curseforge.com/minecraft/mc-mods/mekanism</p> <p>\u5927\u898f\u6a21\u306a\u5de5\u696dmod  \u9271\u77f35\u500d\u3084\u6838\u878d\u5408\u767a\u96fb\u307e\u3067\u697d\u3057\u3081\u307e\u3059</p>"},{"location":"mekanism/#_3","title":"\u9032\u3081\u65b9\uff08\u30c7\u30b8\u30bf\u30eb\u30de\u30a4\u30ca\u30fc\u307e\u3067\uff09","text":"<p>\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3 \u30aa\u30b9\u30df\u30a6\u30e0\uff08\u6c34\u8272\u3063\u307d\u3044\u611f\u3058\u3000\u3069\u3053\u306b\u3067\u3082\u3042\u3063\u3066\u3000\u77f3\u3064\u308b\u306f\u3057\u3067\u6398\u308c\u308b\uff09 \u9244 \u30c0\u30a4\u30e4 \u77f3\u70ad\u307e\u305f\u306f\u6728\u70ad</p> <p>\u3092\u7d50\u69cb\u305f\u304f\u3055\u3093\u7528\u610f\u3057\u307e\u3057\u3087\u3046 \u30aa\u30b9\u30df\u30a6\u30e0\u306f\u88c5\u5099\u306b\u4f7f\u3048\u307e\u3059\u3000\u304b\u306a\u308a\u5f37\u3044\u3067\u3059\uff08\u516c\u5f0f\u30a2\u30c9\u30aa\u30f3\u3000mekanism tools\u3000\u5c0e\u5165\u6642\uff09 \u307e\u305f\u30d1\u30af\u30bb\u30eb\u306f\u6700\u9ad8\u30ec\u30d9\u30eb\u3067\u3059</p> <p>\u51b6\u91d1\u6ce8\u5165\u6a5f \u71b1\u767a\u96fb\u6a5f</p> <p>\u3092\u4f5c\u3063\u3066\u3001\u71b1\u767a\u96fb\u6a5f\u306e\u5468\u308a\u306b\u30de\u30b0\u30de\u3092\u7f6e\u3044\u3066\u3001\u51b6\u91d1\u306b\u9244\u3068\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3\u3084\u3001\u77f3\u70ad\u3092\u52a0\u3048\u308b\u3068\u3044\u308d\u3044\u308d\u306a\u3082\u306e\u304c\u3067\u304d\u308b \u9244+\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3\u3000= \u5439\u8fbc\u5408\u91d1 \u9244+\u6728\u70ad\u307e\u305f\u306f\u77f3\u70ad  = \u6fc3\u7e2e\u9244 \u6fc3\u7e2e\u9244+\u6728\u70ad\u307e\u305f\u306f\u77f3\u70ad =\u3000\u92fc\u9244\u306e\u7c89 \u30aa\u30b9\u30df\u30a6\u30e0+\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3 = \u57fa\u672c\u56de\u8def</p> <p>\u305d\u306e\u3042\u3068</p> <p>\u6fc3\u7e2e\u5ba4 \u57fa\u672c\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30b1\u30fc\u30d6\u30eb</p> <p>\u3092\u4f5c\u308b \u6fc3\u7e2e\u5ba4\u306f\u539f\u77f33\u3092\u7c894\uff08\u713c\u304f\u3068\u30a4\u30f3\u30b4\u30c3\u30c8\uff09\u306b\u3067\u304d\u308b \u307e\u305f\u9271\u77f31\u3092\u7c892\u306b\u3067\u304d\u308b \u8d85\u91cd\u8981\u3000\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3\u3000\uff1d\u3000\u6fc3\u7e2e\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f3         \u77f3\u70ad\u3000\u3000\u3000\u3000\u3000\u3000\uff1d\u3000\u6fc3\u7e2e\u70ad\u7d20         \u30c0\u30a4\u30e4\u30e2\u30f3\u30c9\u3000 \uff1d\u3000\u6fc3\u7e2e\u30c0\u30a4\u30e4\u30e2\u30f3\u30c9         \u9ed2\u66dc\u77f3\u3000\u3000\u3000\u3000\u3000\uff1d\u3000\u9ed2\u66dc\u77f3\u306e\u7c894 \u6fc3\u7e2e\u306b\u3059\u308b\u3068\u51b6\u91d1\u306e\u30af\u30e9\u30d5\u30c8\u306b\u304a\u3044\u3066\u4f8b\u3048\u3070\u5439\u8fbc\u307f\u5408\u91d1\u30928\u4f5c\u308b\u3068\u304d \u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f38\u3068\u92448\u304c\u3044\u308a\u307e\u3059\u304c \u6fc3\u7e2e\u306b\u3059\u308b\u3068 \u6fc3\u7e2e\u30ec\u30c3\u30c9\u30b9\u30c8\u30fc\u30f31\u3068\u92448\u3067\u4f5c\u308c\u307e\u3059 \u51b6\u91d1\u306b\u5165\u308c\u308b\u969b\u306f\u4f55\u3067\u3082\u6fc3\u7e2e\u3057\u307e\u3057\u3087\u3046</p> <p>\u57fa\u672c\u30e6\u30cb\u30d0\u30fc\u30b5\u30eb\u30b1\u30fc\u30d6\u30eb\u306f \u71b1\u767a\u96fb\u6a5f\u3067\u4f5c\u3063\u305f\u96fb\u529b\u3092\u8f38\u9001\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002 \u71b1\u767a\u96fb\u6a5f\u306e\u7dd1\u8272\u306e\u9762\u3068\u3064\u306a\u3052\u307e\u3057\u3087\u3046</p> <p>\u305d\u306e\u3042\u3068</p> <p>\u30aa\u30b9\u30df\u30a6\u30e0\u5727\u7e2e\u6a5f \u98a8\u529b\u767a\u96fb\u6a5f2 \u30a8\u30cd\u30eb\u30ae\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c98 \u77f3\u7f6e\u63db\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9 \u57fa\u672c\u30c6\u30a3\u30a2\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9</p> <p>\u3092\u7528\u610f\u3057\u3066\u3001</p> <p>\u51b6\u91d1\u3000 \u9ed2\u66dc\u77f3\u306e\u7c89+\u30c0\u30a4\u30e4\u3000\uff1d\u3000\u7cbe\u88fd\u9ed2\u66dc\u77f3\u306e\u7c89 \u30aa\u30b9\u30df\u30a6\u30e0\u5727\u7e2e \u7cbe\u88fd\u9ed2\u66dc\u77f3\u306e\u7c89\u3000+\u3000\u30aa\u30b9\u30df\u30a6\u30e0\u3000\uff1d\u3000\u7cbe\u88fd\u9ed2\u66dc\u77f3\u30a4\u30f3\u30b4\u30c3\u30c8</p> <p>\u3053\u308c\u3067\u653b\u648321\u306e\u5145\u96fb\u578b\u5373\u6642\u7834\u58ca\u30c4\u30fc\u30eb\u306e\u539f\u5b50\u5206\u89e3\u6a5f\u306e\u6750\u6599\u304c\u6574\u3046\u306f\u305a \u7d76\u5bfe\u306b\u4f5c\u308a\u307e\u3057\u3087\u3046 \u3042\u3068\u7cbe\u88fd\u9ed2\u66dc\u77f3\u30a4\u30f3\u30b4\u30c3\u30c8\u306f\u88c5\u5099\u306b\u3059\u308b\u3068\u30cd\u30b6\u30e9\u30a4\u30c8\u4ee5\u4e0a\u306b\u5f37\u3044\u3067\u3059\uff08mekanism tools \u5c0e\u5165\u6642\uff09</p> <p>\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3042\u3068\u3067\u4f7f\u3044\u307e\u3059 \u57fa\u672c\u30c6\u30a3\u30a2\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306f\u3057\u3083\u304c\u3093\u3067\u51b6\u91d1\u3092\u53f3\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u4f7f\u3048\u307e\u3059 \u67a0\u304c3\u67a0\u306b\u5897\u3048\u307e\u3059</p> <p>\u3053\u3053\u307e\u3067\u63c3\u3063\u305f\u3089jei\u3092\u99c6\u4f7f\u3057\u3066\u30c7\u30b8\u30bf\u30eb\u30de\u30a4\u30ca\u30fc\u3092\u4f5c\u308a\u307e\u3057\u3087\u3046 \u3067\u304d\u305f\u3089\u3055\u3063\u304d\u4f5c\u3063\u305f\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u5168\u6295\u5165 \u30a8\u30cd\u30eb\u30ae\u30fc\u9762\u306f\u8868\u88cf\u3042\u308a\u307e\u3059\u304c \u7247\u65b9\u306b\u98a8\u529b\u767a\u96fb\u6a5f\u3092\u76f4\u306b\u3064\u3051\u308b \u3082\u3046\u7247\u65b9\u306f\u30a8\u30cd\u30eb\u30ae\u30fc\u30b1\u30fc\u30d6\u30eb\u3092\u4f38\u3070\u3057\u3066\u3044\u308d\u3044\u308d\u96fb\u529b\u3092\u6d88\u8cbb\u3059\u308b\u6a5f\u4f1a\u3092\u7f6e\u3044\u305f\u308a\u307b\u304b\u306e\u767a\u96fb\u6a5f\u3092\u7f6e\u3044\u305f\u308a \u96fb\u529b\u304c\u8db3\u308a\u306a\u3044\u5834\u5408\u306f\u307b\u304b\u306e\u6a5f\u68b0\u306b\u30a8\u30cd\u30eb\u30ae\u30fc\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3092\u7a4d\u307f\u307e\u3057\u3087\u3046 \u3053\u308c\u304c\u3067\u304d\u308c\u3070\u3042\u3068\u306f\u9271\u77f3\u304c\u7121\u9650\u306b\u306a\u308a\u307e\u3059 \u96fb\u529b\u306b\u4f59\u88d5\u304c\u51fa\u3066\u304d\u305f\u3089\u3001\u30b9\u30d4\u30fc\u30c9\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3082\u7a4d\u307f\u307e\u3057\u3087\u3046 \u307e\u305f\u3053\u306e\u30a2\u30a4\u30c6\u30e0\u306e\u4e2d\u9593\u7d20\u6750\u306e\u4e2d\u9593\u7d20\u6750\u306e\u30d1\u30fc\u30bd\u30ca\u30eb\u30c1\u30a7\u30b9\u30c8\u306f\u975e\u5e38\u306b\u5f37\u529b\u3067\u3059 \u7acb\u3063\u305f\u307e\u307e\u958b\u3051\u308b\u30b7\u30e5\u30eb\u30ab\u30fc\u30dc\u30c3\u30af\u30b9\u3067\u3059</p>"},{"location":"mekanism/#5","title":"\u9032\u3081\u65b9\uff08\u9271\u77f35\u500d\u5316\u307e\u3067\uff09","text":"<p>\u9271\u77f3\u30925\u500d\u5316\u3057\u305f\u3044\u3068\u3053\u308d\u3067\u3059\u304c\u96fb\u529b\u304c\u306a\u3044\u3067\u3059 \u306a\u306e\u3067\u30ac\u30b9\u767a\u96fb\u6a5f\u3092\u4f5c\u308a\u307e\u3057\u3087\u3046 \u4ee5\u4e0b\u3092\u7528\u610f</p> <p>\u30ac\u30b9\u767a\u96fb\u6a5f \u57fa\u672c\u52a0\u5727\u30c1\u30e5\u30fc\u30d6 \u52a0\u5727\u53cd\u5fdc\u5ba4 \u96fb\u89e3\u5206\u96e2\u6a5f \u7c89\u7815\u6a5f \u57fa\u672c\u7269\u6d41\u30c8\u30e9\u30f3\u30b9\u30dd\u30fc\u30bf\u30fc \u5927\u91cf\u306e\u4f5c\u7269\u307e\u305f\u306f\u7121\u9650\u5316\u3057\u305f\u4f5c\u7269\u304c\u5165\u3063\u305f\u5165\u308c\u7269\u7cfb\uff08\u30c1\u30a7\u30b9\u30c8etc\uff09 \u57fa\u672c\u30e1\u30ab\u30cb\u30ab\u30eb\u30d1\u30a4\u30d7 \u96fb\u52d5\u30dd\u30f3\u30d7 \u57fa\u672c\u5316\u5b66\u30bf\u30f3\u30af</p> <p>\u7c89\u7815\u6a5f \u4f5c\u7269\u7cfb\u3000\u2192\u3000\u30d0\u30a4\u30aa\u71c3\u6599</p> <p>\u96fb\u89e3\u5206\u96e2\u6a5f \u6c34\u3000\u2192\u3000\u6c34\u7d20\u3000+\u3000\u9178\u7d20</p> <p>\u52a0\u5727\u53cd\u5fdc\u5ba4 \u30d0\u30a4\u30aa\u71c3\u6599+\u6c34+\u6c34\u7d20\u3000\uff1d\u3000\u57fa\u8cea+\u30a8\u30c1\u30ec\u30f3</p> <p>\u30ac\u30b9\u767a\u96fb\u6a5f \u30a8\u30c1\u30ec\u30f3\u2192\u96fb\u529b</p> <p>\u57fa\u8cea\u306f\u30b4\u30df\u3067\u3059 \u7d42\u76e4\u307e\u3067\u3044\u308a\u307e\u305b\u3093 \u30ac\u30b9\u767a\u96fb\u6a5f\u306f\u6c34\u7d20\u3092\u5165\u308c\u3066\u767a\u96fb\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u304c \u767a\u96fb\u91cf\u304c\u5c11\u306a\u304f\u96fb\u89e3\u5206\u96e2\u6a5f\u7a3c\u50cd\u30b3\u30b9\u30c8\u3088\u308a\u3082\u4e0b\u56de\u308b\u306e\u3067 \u610f\u5473\u306a\u3044\u3067\u3059 \u30a8\u30c1\u30ec\u30f3\u306f\u30b9\u30c8\u30c3\u30af\u3067\u304d\u308b\u57fa\u672c\u5316\u5b66\u30bf\u30f3\u30af\u306b\u5165\u308c\u3066\u304a\u304f\u3068\u3044\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093 \u6c34\u306f\u96fb\u52d5\u30dd\u30f3\u30d7\u3067\u5438\u3044\u4e0a\u3052\u307e\u3059 \u9593\u9055\u3063\u305f\u3082\u306e\u3092\u5165\u308c\u305f\u3089\u3000\u30b9\u30dd\u30a4\u30c8\u3000\u3092\u4f7f\u3044\u307e\u3057\u3087\u3046 \u3055\u3063\u304d\u51fa\u3066\u304d\u305f\u30ec\u30b7\u30d4\u4ee5\u5916\u306e\u3082\u306e\u306f\u30a8\u30c1\u30ec\u30f3\u7121\u9650\u5316\u7528\u3067\u3059</p> <p>\u7121\u9650\u5316</p>"},{"location":"polandballcard/","title":"\u30dd\u30fc\u30e9\u30f3\u30c9\u30dc\u30fc\u30eb\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u5316\u8a08\u753b","text":"<p>\u8a08\u753b\u6bb5\u968e\u3000\u30ab\u30fc\u30c9\u306f\u968f\u6642\u8ffd\u52a0\u3000\u6765\u5e74\u3054\u308d\u30b2\u30fc\u30e0\u5316 \u300eWWI Polandball\u300f  \u6700\u7d42\u66f4\u65b026/11/25 ver0.01a \u30b9\u30bf\u30fc\u30c8\u30c7\u30c3\u30ad\u5354\u5546\u4eee\u6c7a\u5b9a</p>"},{"location":"polandballcard/#_2","title":"\u30dd\u30fc\u30e9\u30f3\u30c9\u30dc\u30fc\u30eb\u30ab\u30fc\u30c9\u30b2\u30fc\u30e0\u5316\u8a08\u753b\u3068\u306f","text":"<p>\u306a\u3093\u304b\u4f5c\u308a\u305f\u304f\u306a\u3063\u3066\u3057\u307e\u3063\u305f \u30b2\u30fc\u30e0\u4f5c\u308a\u306e\u7df4\u7fd2\u3082\u304b\u306d\u3066 \u30d1\u30e9\u30aa\u5f37\u3044\u3068\u30b7\u30e7\u30fc\u30c8\u304c\u8513\u5ef6\u3057\u305f\u30dd\u30fc\u30e9\u30f3\u30c9\u30dc\u30fc\u30eb\u306b\u7d42\u6b62\u7b26\u3092\u6253\u3064\uff08\u9858\u671b\uff09 \u30dd\u30b1\u30ab\u3068\u30c7\u30e5\u30a8\u30de\u3068hoi4\u30923:2:5\u3067\u6df7\u305c\u305f\u611f\u3058 ww2\u306f\u8907\u96d1\u306a\u306e\u3067\u306d\u3000</p>"},{"location":"polandballcard/#_3","title":"\u30eb\u30fc\u30eb","text":"<ol> <li>\u30b2\u30fc\u30e0\u306e\u76ee\u7684\u3068\u52dd\u5229\u6761\u4ef6 \u30b2\u30fc\u30e0\u52dd\u5229\u6761\u4ef6\uff1a \u76f8\u624b\u306e\u56fd\u5bb6\u30ab\u30fc\u30c9\u30923\u56fd\u6483\u7834\u3055\u305b\u305f\u3089\u52dd\u5229\u3002</li> <li>\u30c7\u30c3\u30ad\u69cb\u7bc9\u3068\u57fa\u672c\u65b9\u91dd \u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u300c\u5354\u5546\u56fd\u30c7\u30c3\u30ad\u300d\u307e\u305f\u306f\u300c\u4e2d\u592e\u540c\u76df\u56fd\u30c7\u30c3\u30ad\u300d\u306e\u3044\u305a\u308c\u304b\u3092\u9078\u3076\u3002</li> </ol> <p>\u4e2d\u7acb\u30fbIF\u30ab\u30fc\u30c9\uff1a \u300c\u4e2d\u7acb\u56fd\uff08IF\uff09\u300d\u30bf\u30b0\u3092\u6301\u3064\u30ab\u30fc\u30c9\uff08\u30dd\u30fc\u30e9\u30f3\u30c9\u3001\u30ea\u30c8\u30a2\u30cb\u30a2\u306a\u3069\uff09\u306f\u3001\u4e21\u9663\u55b6\u3069\u3061\u3089\u306e\u30c7\u30c3\u30ad\u306b\u3082\u7d44\u307f\u8fbc\u3080\u3053\u3068\u304c\u3067\u304d\u308b\u3002</p> <p>\u56fd\u529b\u57fa\u6e96\u5024\uff1a \u30c9\u30a4\u30c4\u5e1d\u56fd\u306e\u521d\u671f\u80fd\u529b\uff08\u4eba\u7684100 / \u5de5\u696d100 / \u8cc7\u6e90100\uff09\u3092\u7d76\u5bfe\u7684\u306a\u300c100\u300d\u306e\u57fa\u6e96\u3068\u3057\u3001\u4ed6\u56fd\u306e\u6570\u5024\u3092\u76f8\u5bfe\u8a55\u4fa1 \u305d\u306e\u56fd\u306e\u964d\u4f0f\u9650\u754c\u5024(20) \u56fd\u5bb6\u5f62\u6210\u3092\u3059\u308b\u3068\u3001\u964d\u4f0f\u9650\u754c\u5024\u304c\u9ad8\u307e\u308b\u3002</p> <ol> <li>\u6226\u5834\u30fb\u30a8\u30ea\u30a2\u306e\u69cb\u6210 \u30e1\u30a4\u30f3\u30a8\u30ea\u30a2\uff1a \u4e3b\u529b\u3068\u3057\u3066\u6226\u5834\u306b\u7acb\u3064\u56fd\u5bb6\u30ab\u30fc\u30c9\u3092\u7f6e\u304f\u5834\u6240\u3002</li> </ol> <p>\u30b5\u30d6\u30a8\u30ea\u30a2\uff1a \u30b5\u30d6\u306b\u306a\u308b\u30ab\u30fc\u30c9\u3092\u7f6e\u304f\u5834\u6240\u3002</p> <p>\u5c71\u672d\u3000\u30c7\u30c3\u30ad\u306f50\u679a</p> <p>\u5175\u58eb\u30ab\u30fc\u30c9\u5c71\u672d\u3000\u304a\u4e92\u304410\u679a\u3000\u30c7\u30c3\u30ad\u306b\u306f\u542b\u307e\u306a\u3044\u3000\u3059\u3079\u3066\u6027\u80fd\u306f\u540c\u3058\u3067\u3042\u308b</p> <p>\u5893\u5730\u3000\u624b\u672d\u3092\u6368\u3066\u305f\u308a\u3059\u308b\u3068\u3053\u308d</p> <p>\u624b\u672d\u3000\u81ea\u5206\u306e\u624b\u672d\u3000\u5f8c\u653b\u306f3\u679a\u591a\u304f\u30b2\u30fc\u30e0\u30b9\u30bf\u30fc\u30c8</p> <p>\u88dc\u7d66\uff08\u30b7\u30b9\u30c6\u30e0\uff1a \u5175\u58eb\u304c\u5b58\u5728\u3002\u884c\u52d5\u3084\u6226\u95d8\u3067\u6e1b\u5c11\u3057\u300150%\u672a\u6e80\u306b\u306a\u308b\u3068\u5f31\u4f53\u5316\u3059\u308b\u3002 4. \u3000\u5175\u58eb \u81ea\u5206\u306e\u30bf\u30fc\u30f3\u306e\u306f\u3058\u3081\u306b2\u4f53\u307e\u3067\u5175\u58eb\u3092\u53ec\u559a\u3067\u304d\u308b\u3002 \u5175\u58eb\u53ec\u559a\u306b\u306f\u3001\u30b3\u30b9\u30c8\u4eba\u768410\u3000\u5de5\u696d10\u3000\u8cc7\u6e9010\u304c\u304b\u304b\u308b\u3002 \u540c\u6642\u306b10\u307e\u3067\u53ec\u559a\u3067\u304d\u308b\u3002 \u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u88dc\u7d66\u3000 \u88dc\u7d66\u306f10\u304c\u9650\u5ea6\u3067\u3001\u53ec\u559a\u3057\u305f\u3068\u304d\u306f10\u3042\u308b \u653b\u6483\u3059\u308b\u3068\u304d\u306b\u306f\u3001\u88dc\u7d66\u306f1\u6e1b\u308b \u4f5c\u6226\u3092\u884c\u3046\u3068\u304d\u306f\u3001\u305d\u306e\u30ab\u30fc\u30c9\u306b\u66f8\u304b\u308c\u305f\u30b3\u30b9\u30c8\u5206 5\u3000\u30d0\u30c8\u30eb\u306e\u65b9\u5f0f \u59cb\u3081 \u3058\u3083\u3093\u3051\u3093\u3068\u304b\u3067\u5148\u653b\u5f8c\u653b\u3092\u6c7a\u3081\u308b \u81ea\u5206\u306e\u30c7\u30c3\u30ad\u306e\u4e2d\u304b\u3089\u3001\u56fd\u5bb6\u30ab\u30fc\u30c9\u3092\u4e00\u679a\u9078\u3093\u3067\u30e1\u30a4\u30f3\u30a8\u30ea\u30a2\u306b\u7f6e\u304f\u3002 \u30c7\u30c3\u30ad\u3092\u30b7\u30e3\u30c3\u30d5\u30eb\uff08\u4ee5\u4e0b\u5c71\u672d\uff09\u3057\u3066\u5c71\u672d\u304b\u30895\u679a\u5f15\u3044\u3066\u624b\u672d\u306b\u3059\u308b\u3002 \u5f8c\u653b\u306f8\u679a\u5f15\u3051\u308b\u3002 \u4ffa\u306e\u30bf\u30fc\u30f3\u3000\u30c9\u30ed\u30fc\uff01\uff01 1\u3000\u30ab\u30fc\u30c9\u3092\u4e00\u679a\u5f15\u304f 2\u3000\u30e1\u30a4\u30f3\u30a8\u30ea\u30a2\u306e\u30ab\u30fc\u30c9\u306f\u6700\u5927\u30b9\u30c6\u30fc\u30bf\u30b9\u306e25%\u3001SP\u4ee5\u5916\u3092\u56de\u5fa9\u3059\u308b \u30b5\u30d6\u30a8\u30ea\u30a2\u306e\u30ab\u30fc\u30c9\u306f\u6700\u5927\u30b9\u30c6\u30fc\u30bf\u30b9\u306e15%\u3000SP\u4ee5\u5916\u3092\u56de\u5fa9\u3059\u308b 4\u3000\u5175\u58eb\u3092\u53ec\u559a\u3059\u308b\u304b\u6c7a\u3081\u308b(0~2)\u6700\u592710\u307e\u3067 5\u3000\u5175\u58eb\u306e\u88dc\u7d66\u3092\u56de\u5fa9\u3059\u308b\u304b\u6c7a\u3081\u308b \u30e1\u30a4\u30f3\u30a8\u30ea\u30a2\u306e\u30ab\u30fc\u30c9\u306e\u4eba\u7684\u3068\u5de5\u696d\u3068\u8cc7\u6e90\u30923\u305a\u3064\u6e1b\u3089\u3059\u3068\u5175\u58eb\u4e00\u4f53\u306e\u88dc\u7d66\u304c1\u56de\u5fa9\u3059\u308b\u3002\u3000\u3069\u306e\u5175\u58eb\u3092\u3069\u306e\u304f\u3089\u3044\u56de\u5fa9\u3059\u308b\u304b\u306f\u81ea\u7531\u3067\u3001\u56de\u5fa9\u3057\u306a\u304f\u3066\u3082\u3088\u3044 6 \u30b5\u30d6\u30a8\u30ea\u30a2\u306b\u7a7a\u304d\u304c\u3042\u308c\u3070\u3001\u597d\u304d\u306a\u56fd\u5bb6\u30ab\u30fc\u30c9\u3092\u9078\u3093\u3067\u51fa\u3057\u3066\u3082\u3088\u3044 7\u3000\u4f5c\u6226\u653f\u6cbb\u30ab\u30fc\u30c9\u3092\u5408\u8a083\u679a\u307e\u3067\u4f7f\u7528\u3057\u3066\u3082\u3088\u3044\u3000\u4f5c\u6226\u30ab\u30fc\u30c9\u306f\u8868\u5411\u304d\u3067\u304a\u3044\u3066\u7f6e\u304f\u3002\u5ea6\u306e\u5175\u58eb\u3067\u653b\u6483\u3059\u308b\u304b\u3092\u5ba3\u8a00\u3059\u308b\u3002 8\u3000\u5148\u306b\u4f5c\u6226\u653f\u6cbb\u30ab\u30fc\u30c9\u306e\u51e6\u7406\u3092\u884c\u3046\u3002\u9806\u5e8f\u306f\u81ea\u7531\u3067\u3088\u3044 9\u3000\u5175\u58eb\u30ab\u30fc\u30c9\u3067\u653b\u6483\u3092\u884c\u3063\u3066\u3082\u3088\u3044\u3002\u5175\u58eb\u4e00\u4f53\u3067\u3001\u57fa\u790e\u653b\u6483\u529b2\u306b\u3059\u3079\u3066\u306e\u30d0\u30d5\u3092\u52a0\u7b97\u3057\u3066\u5c0f\u6570\u70b9\u7b2c\u4e00\u4f4d\u3067\u5207\u308a\u4e0a\u3052\u305f\u5024\u3092\u76f8\u624b\u306e\u5175\u58eb\u4e00\u4f53\u306b\u4e0e\u3048\u3001\u76f8\u624b\u306e\u88dc\u7d66\u30b2\u30fc\u30b8\u3092\u6e1b\u3089\u3059\u3002\u5175\u58eb\u30ab\u30fc\u30c9\u3067\u653b\u6483\u3092\u884c\u3063\u305f\u5f8c\u306f\u3001\u88dc\u7d66-1\u306b\u3059\u3079\u3066\u306e\u30c7\u30d0\u30d5\u3092\u52a0\u7b97\u3057\u305f\u5024\u3092\u305d\u306e\u5175\u58eb\u306b\u4e0e\u3048\u308b\u3002\u3082\u3057\u76f8\u624b\u306e\u5175\u58eb\u306e\u6570\u304c\u81ea\u5206\u3088\u308a\u4e0a\u56de\u3063\u3066\u3044\u3066\u3001\u7dcf\u88dc\u7d66\u3082\u4e0a\u56de\u3063\u3066\u3044\u305f\u3089\u3001\u76f8\u624b\u306e\u56fd\u5bb6\u30ab\u30fc\u30c9\u306b\u76f4\u63a5\u653b\u6483\u304c\u3067\u304d\u308b\u3002\u76f8\u624b\u306eSP\u30925\u6e1b\u3089\u3059\u3002\u30d0\u30d5\u3067\u4e0a\u4e57\u305b\u3067\u304d\u308b\u3002SP\u304c0\u306b\u306a\u3063\u305f\u3089\u3001\u5c02\u7528\u4f5c\u6226\u30ab\u30fc\u30c9\u3067\u6483\u7834\u304c\u3067\u304d\u308b\u3002 10\u3000\u76f8\u624b\u306e\u30bf\u30fc\u30f3\u3092\u7e70\u308a\u8fd4\u3057\u3066\u30013\u4f53\u5012\u3057\u305f\u65b9\u306e\u52dd\u3061\u3002</p> <p>\u30ab\u30fc\u30c9\u306e\u7a2e\u985e \u5148\u884c\u516c\u958b\u3000\u30b9\u30bf\u30fc\u30c8\u30c7\u30c3\u30ad\u5354\u5546\u3000\u30b9\u30bf\u30fc\u30c8\u30c7\u30c3\u30ad\u4e2d\u592e \u5909\u66f4\u306e\u53ef\u80fd\u6027\u5927\u6709\u308a \u30ae\u30ea\u30b7\u30e3\u3000</p> <p>[\u56fd\u5bb6\u30ab\u30fc\u30c9] \u5354\u5546\u56fd [\u56fd\u529b]\u3000\u4eba\u768435 \u5de5\u696d25 \u8cc7\u6e9030 SP 20 [\u56fa\u6709\u52b9\u679c] \u30e1\u30ac\u30ea\u30a4\u30c7\u30a2\u3000\u30aa\u30b9\u30de\u30f3\u5e1d\u56fd\u306b\u5bfe\u3059\u308b\u653b\u6483+30%\u3000\u7269\u8cc7\u6d88\u8cbb-5% \u30aa\u30b9\u30de\u30f3\u5e1d\u56fd\u3092\u6483\u7834\u3057\u305f\u306a\u3089\u3001\u56fd\u540d\u3092[\u5927\u30ae\u30ea\u30b7\u30e3]\u306b\u5909\u66f4\u3057\u3001\u4eba\u7684\u5de5\u696d\u8cc7\u6e90SP\u3092\u305d\u308c\u305e\u308c+10\u3057\u3001\u3053\u306e\u56fd\u306b[\u30e1\u30ac\u30ea\u30fb\u30a4\u30c7\u30a2\u306e\u5b8c\u9042] \u3092\u4e0e\u3048\u308b\u3002 [\u30e1\u30ac\u30ea\u30fb\u30a4\u30c7\u30a2\u306e\u5b8c\u9042]\u3000\u30b2\u30fc\u30e0\u4e2d\u3001\u81ea\u5206\u306e\u3059\u3079\u3066\u306e\u30ab\u30fc\u30c9\u306e\u653b\u9632+20%</p> <p>[\u56fd\u5bb6\u5f62\u6210]???\u3000[\u30e1\u30ac\u30ea\u30fb\u30a4\u30c7\u30a2\u306e\u5b8c\u9042]\u3092\u6709\u3057\u3066\u304a\u308a\u3001\u624b\u672d\u306b[\u56fd\u540d]\u304c\u3042\u308a\u3001\u30e1\u30a4\u30f3\u30a8\u30ea\u30a2\u307e\u305f\u306f\u30b5\u30d6\u30a8\u30ea\u30a2\u306b[\u56fd\u540d]\u304c\u3042\u308a\u3001[\u56fd\u540d]\u3092\u6483\u7834\u3059\u308b\u3002\u307e\u305f\u306f\u3001[\u56fd\u540d]\u306e\u6483\u7834 [\u30e1\u30ac\u30ea\u30fb\u30a4\u30c7\u30a2\u306e\u5b8c\u9042]\u52b9\u679c\u3092\u53d7\u3051\u7d99\u3044\u3060\u30d0\u30eb\u30ab\u30f3\u9023\u90a6\u306b\u306a\u308b\u3002 PBSD2 012/019 [R]</p> <p>\u56fd\u5bb6\u5f62\u6210\u3068\u306f\u3001\u6761\u4ef6\u3092\u6e80\u305f\u3057\u305f\u3089\u3055\u3089\u306b\u5f37\u3044\u56fd\u5bb6\u306b\u306a\u308c\u308b\u30b7\u30b9\u30c6\u30e0 \u30b2\u30fc\u30e0\u30eb\u30fc\u30eb\u304c\u8907\u96d1\u306a\u306e\u3067\u3001\u7c21\u7565\u5316\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u306a\u3044 \u56fd\u5bb6\u306f\u5168\u90e8R  \u30ec\u30a2\u30ea\u30c6\u30a3\u306fPOR  SR   VR   R   U  C \u56fd\u5bb6\u5f62\u6210\u306f\u4f55\u3060\u308d\u3046\u306d\u3000\u30d2\u30f3\u30c8\u306f\u30d6\u30eb\u30ac\u30ea\u30a2 \u6c7a\u307e\u3063\u3066\u308b\u3051\u3069\u30b7\u30fc\u30af\u30ec\u30c3\u30c8</p> <p>\u5879\u58d5\u6226</p> <p>[\u4f5c\u6226\u30ab\u30fc\u30c9] \u6c4e\u7528\u3000 [\u56fa\u6709\u52b9\u679c] \u3053\u306e\u30ab\u30fc\u30c9\u306f8\u679a\u307e\u3067\u5165\u308c\u3066\u3088\u3044\u3002 \u81ea\u5206\u306e\u30e1\u30a4\u30f3\u30a8\u30ea\u30a2\u306e\u30ab\u30fc\u30c9\u306b\u3001\u3053\u306e\u30bf\u30fc\u30f3\u4e2d\u4ee5\u4e0b\u306e\u52b9\u679c\u3092\u4ed8\u4e0e \u5879\u58d5\u6226\u3000\u5175\u58eb\u653b\u6483-5%\u3000\u5175\u58eb\u9632\u5fa1+10% PBSD2 006/014 [U]</p> <p>WW1\u306f\u5879\u58d5\u6226\u3067\u6709\u540d\u3060\u3051\u3069\u3001\u305d\u3053\u307e\u3067\u4f7f\u3044\u305f\u304c\u3089\u306a\u3044\u52b9\u679c\u306a\u306e\u304c\u306d \u3082\u3046\u3061\u3087\u3063\u3068\u5f37\u304f\u3059\u308b\u304b\u3082\u3057\u308c\u306a\u3044</p> <p>\u30eb\u30fc\u30de\u30cb\u30a2</p> <p>[\u56fd\u5bb6\u30ab\u30fc\u30c9] \u5354\u5546\u56fd [\u56fd\u529b]\u3000\u4eba\u768445 \u5de5\u696d25 \u8cc7\u6e9075 SP 20 [\u56fa\u6709\u52b9\u679c] \u5931\u308f\u308c\u305f\u5